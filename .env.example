# =============================================================
# RTR 360 — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================

# Database (PostgreSQL — Supabase)
# Get your connection string from Supabase → Settings → Database → Connection string
# Use the "Transaction pooler" URI for Vercel, or "Session mode" for local dev
# On Vercel with Supabase integration: POSTGRES_PRISMA_URL is auto-set
DATABASE_URL=postgresql://user:pass@host:5432/postgres?pgbouncer=true&connect_timeout=15

# Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET=

# AI Integration (Z.ai SDK)
ZAI_API_KEY=

# Optional: External GPS Protocol Server
GPS_PROTOCOL_HOST=
GPS_PROTOCOL_PORT=

# Setup Protection (required in production)
SETUP_INIT_KEY=

# Optional: Redis (Upstash for serverless)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Observability
SENTRY_DSN=

# Optional: AI (OpenAI for chat features)
OPENAI_API_KEY=

# Optional: Email Provider (SMTP for transactional emails)
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=RTR 360
