# =============================================================
# RTR 360 — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================

# Database
# Development (SQLite):  file:./db/custom.db
# Production (PostgreSQL/Supabase): postgresql://user:pass@host:5432/rtr360?schema=public
DATABASE_URL=file:./db/custom.db

# Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET=

# AI Integration (Z.ai SDK)
ZAI_API_KEY=

# Optional: External GPS Protocol Server
GPS_PROTOCOL_HOST=
GPS_PROTOCOL_PORT=
