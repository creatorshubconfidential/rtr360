generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// RTR 360 — Fleet Technology & Management Platform
// Powered by Mianx.ai | Multi-tenant SaaS Architecture
// ============================================================

// ----------------------
// TENANT & ORGANIZATION
// ----------------------

model Organization {
  id            String   @id @default(cuid())
  name          String
  tradeName     String?  @map("trade_name")
  legalName     String?  @map("legal_name")
  industry      String?
  email         String?
  phone         String?
  website       String?
  emirate       String?
  address       String?
  city          String?
  country       String   @default("AE")
  logo          String?
  status        String   @default("active")
  currency      String   @default("AED")
  timezone      String   @default("Asia/Dubai")
  locale        String   @default("en")
  // White-label branding
  primaryColor  String?  @map("primary_color")
  accentColor   String?  @map("accent_color")
  customLogo    String?  @map("custom_logo")
  favicon       String?
  loginBgImage  String?  @map("login_bg_image")
  customDomain  String?  @map("custom_domain")
  domainVerified Boolean  @default(false) @map("domain_verified")
  whiteLabelEnabled Boolean @default(false) @map("white_label_enabled")
  brandedAppName   String? @map("branded_app_name")
  brandedFooter   String? @map("branded_footer")
  hideMianxBranding Boolean @default(false) @map("hide_mianx_branding")
  // Plan limits
  planName      String?  @map("plan_name")
  vehicleLimit  Int      @default(0) @map("vehicle_limit")
  userLimit     Int      @default(0) @map("user_limit")
  featureFlags  String?  @map("feature_flags")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  branches       Branch[]
  users          User[]
  vehicles       Vehicle[]
  drivers        Driver[]
  devices        Device[]
  leads          Lead[]
  contacts       Contact[]
  opportunities  Opportunity[]
  geofences      Geofence[]
  alertRules     AlertRule[]
  alerts         Alert[]
  tickets        Ticket[]
  contracts      Contract[]
  invoices       Invoice[]
  documents      Document[]
  notifications  Notification[]
  quotations    Quotation[]
  technicians   Technician[]
  installations  Installation[]
  maintenanceRecords MaintenanceRecord[]
  subscriptions  Subscription[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[] @relation("AuditLogOrganization")
  sims           SIM[]
  aiConversations AIConversation[]
  trips          Trip[]
  activities     Activity[]

  @@index([status])
  @@index([emirate])
}

model Branch {
  id             String   @id @default(cuid())
  name           String
  address        String?
  emirate        String?
  phone          String?
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicles       Vehicle[]
  @@index([organizationId])
}

// ----------------------
// AUTH, USERS & ROLES
// ----------------------

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?  @map("password_hash")
  name           String
  phone          String?
  avatar         String?
  role           String   @default("viewer")
  organizationId String?  @map("organization_id")
  status         String   @default("active")
  lastLoginAt    DateTime? @map("last_login_at")
  emailVerified  Boolean  @default(false) @map("email_verified")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization? @relation(fields: [organizationId], references: [id])
  auditLogs      AuditLog[]
  activities     Activity[]
  assignedLeads  Lead[] @relation("LeadAssigned")
  assignedOpportunities Opportunity[] @relation("OpportunityAssigned")
  assignedTickets  Ticket[] @relation("TicketAssigned")
  documents      Document[] @relation("DocumentUploader")
  notifications  Notification[] @relation("NotificationUser")
  aiConversations AIConversation[] @relation("AIConversationUser")
  sessions       Session[]
  apiKeys        ApiKey[]
  @@index([organizationId])
  @@index([role])
  @@index([status])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  action        String
  entity        String
  entityId      String?  @map("entity_id")
  metadata      String?
  ipAddress     String?  @map("ip_address")
  organizationId String?  @map("organization_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User?    @relation(fields: [userId], references: [id])
  organization   Organization? @relation("AuditLogOrganization", fields: [organizationId], references: [id])
  @@index([userId])
  @@index([organizationId])
  @@index([action])
  @@index([createdAt])
}

// ----------------------
// CRM — LEADS & CONTACTS
// ----------------------

model Lead {
  id             String   @id @default(cuid())
  name           String
  email          String?
  phone          String?
  company        String?
  emirate        String?
  vehicleCount   Int?     @map("vehicle_count")
  vehicleType    String?  @map("vehicle_type")
  requirement    String?
  source         String?
  campaign       String?
  landingPage    String?  @map("landing_page")
  utmSource      String?  @map("utm_source")
  utmMedium      String?  @map("utm_medium")
  utmCampaign    String?  @map("utm_campaign")
  status         String   @default("new")
  priority       String   @default("medium")
  assignedToId   String?  @map("assigned_to_id")
  organizationId String?  @map("organization_id")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization? @relation(fields: [organizationId], references: [id])
  assignedTo     User?         @relation("LeadAssigned", fields: [assignedToId], references: [id])
  activities     Activity[]
  opportunities  Opportunity[] @relation("OpportunityLead")
  quotations     Quotation[]
  @@index([organizationId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
}

model Contact {
  id             String   @id @default(cuid())
  name           String
  email          String?
  phone          String?
  position       String?
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotations     Quotation[]
  @@index([organizationId])
}

model Opportunity {
  id             String   @id @default(cuid())
  name           String
  value          Float?
  stage          String   @default("new")
  leadId         String?  @map("lead_id")
  organizationId String   @map("organization_id")
  assignedToId   String?  @map("assigned_to_id")
  expectedClose  DateTime? @map("expected_close")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo     User?         @relation("OpportunityAssigned", fields: [assignedToId], references: [id])
  lead           Lead?         @relation("OpportunityLead", fields: [leadId], references: [id])
  activities     Activity[]
  @@index([organizationId])
  @@index([leadId])
  @@index([stage])
}

model Activity {
  id             String   @id @default(cuid())
  type           String
  title          String
  description    String?
  dueDate        DateTime? @map("due_date")
  completed      Boolean  @default(false)
  userId         String?  @map("user_id")
  leadId         String?  @map("lead_id")
  opportunityId  String?  @map("opportunity_id")
  organizationId String?  @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user           User?       @relation(fields: [userId], references: [id])
  lead           Lead?       @relation(fields: [leadId], references: [id])
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  @@index([userId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([organizationId])
}

// ----------------------
// FLEET — VEHICLES
// ----------------------

model Vehicle {
  id             String   @id @default(cuid())
  internalId     String?  @map("internal_id")
  plateNumber    String   @map("plate_number")
  make           String?
  model          String?
  year           Int?
  vehicleType    String?  @map("vehicle_type")
  vin            String?
  color          String?
  organizationId String   @map("organization_id")
  branchId       String?  @map("branch_id")
  driverId       String?  @map("driver_id")
  deviceId       String?  @map("device_id")
  status         String   @default("active")
  mileage        Float?
  engineHours    Float?  @map("engine_hours")
  installDate    DateTime? @map("install_date")
  warrantyExpiry DateTime? @map("warranty_expiry")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?    @relation(fields: [branchId], references: [id])
  driver         Driver?    @relation(fields: [driverId], references: [id])
  device         Device?    @relation(fields: [deviceId], references: [id])
  trips          Trip[]
  installations  Installation[]
  alerts         Alert[] @relation("AlertVehicle")
  maintenanceRecords MaintenanceRecord[]
  @@index([organizationId])
  @@index([plateNumber])
  @@index([driverId])
  @@index([deviceId])
  @@index([status])
}

// ----------------------
// FLEET — DRIVERS
// ----------------------

model Driver {
  id             String   @id @default(cuid())
  name           String
  employeeId     String?  @map("employee_id")
  phone          String?
  email          String?
  licenseNumber  String?  @map("license_number")
  licenseType    String?  @map("license_type")
  licenseExpiry  DateTime? @map("license_expiry")
  emirate        String?
  nationality    String?
  passportNumber String?  @map("passport_number")
  dateOfBirth    DateTime? @map("date_of_birth")
  emergencyContact String? @map("emergency_contact")
  emergencyPhone   String? @map("emergency_phone")
  organizationId String   @map("organization_id")
  status         String   @default("active")
  score          Float    @default(100)
  totalTrips     Int      @default(0) @map("total_trips")
  totalDistance   Float?   @map("total_distance")
  totalViolations Int     @default(0) @map("total_violations")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicles       Vehicle[]
  @@index([organizationId])
  @@index([status])
  @@index([licenseNumber])
}

// ----------------------
// FLEET — DEVICES & SIMS
// ----------------------

model Device {
  id             String   @id @default(cuid())
  imei           String   @unique
  serialNumber   String?  @map("serial_number")
  model          String?
  manufacturer   String?
  deviceType     String?  @map("device_type")
  protocol       String?
  phoneNumber    String?
  firmware       String?
  simId          String?  @map("sim_id")
  organizationId String?  @map("organization_id")
  warehouse      String?
  status         String   @default("warehouse")
  purchaseDate   DateTime? @map("purchase_date")
  purchaseCost   Float?   @map("purchase_cost")
  installDate    DateTime? @map("install_date")
  warrantyExpiry DateTime? @map("warranty_expiry")
  lastPingAt     DateTime? @map("last_ping_at")
  batteryLevel   Int?     @map("battery_level")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization? @relation(fields: [organizationId], references: [id])
  vehicles       Vehicle[]
  installations  Installation[]
  sim            SIM?      @relation(fields: [simId], references: [id])
  @@index([organizationId])
  @@index([status])
}

model SIM {
  id             String   @id @default(cuid())
  number         String   @unique
  provider       String?
  dataPlan       String?  @map("data_plan")
  status         String   @default("available")
  activatedAt    DateTime? @map("activated_at")
  organizationId String?  @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  devices        Device[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  @@index([organizationId])
  @@index([status])
}

// ----------------------
// OPERATIONS — TECHNICIANS
// ----------------------

model Technician {
  id             String   @id @default(cuid())
  name           String
  phone          String
  email          String?
  emirate        String?
  specialty      String?
  organizationId String   @map("organization_id")
  status         String   @default("active")
  totalInstalled Int      @default(0) @map("total_installed")
  rating         Float    @default(0)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installations  Installation[]
  @@index([organizationId])
  @@index([status])
}

// ----------------------
// OPERATIONS — INSTALLATIONS
// ----------------------

model Installation {
  id             String   @id @default(cuid())
  installationNumber String @unique @map("installation_number")
  organizationId String   @map("organization_id")
  vehicleId      String   @map("vehicle_id")
  deviceId       String   @map("device_id")
  technicianId   String?  @map("technician_id")
  status         String   @default("scheduled")
  scheduledDate  DateTime? @map("scheduled_date")
  scheduledTime  String?  @map("scheduled_time")
  completedAt    DateTime? @map("completed_at")
  emirate        String?
  location       String?
  latitude       Float?
  longitude      Float?
  photos         String?
  testResult     String?  @map("test_result")
  gpsSignal      Boolean? @default(false) @map("gps_signal")
  powerWiring    Boolean? @default(false) @map("power_wiring")
  antennaMounted Boolean? @default(false) @map("antenna_mounted")
  signature      String?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  technician    Technician?  @relation(fields: [technicianId], references: [id])
  vehicle       Vehicle    @relation(fields: [vehicleId], references: [id])
  device        Device     @relation(fields: [deviceId], references: [id])
  @@index([organizationId])
  @@index([status])
  @@index([technicianId])
  @@index([vehicleId])
  @@index([deviceId])
}

// ----------------------
// FLEETOS — TRIPS
// ----------------------

model Trip {
  id             String   @id @default(cuid())
  vehicleId      String   @map("vehicle_id")
  organizationId String?  @map("organization_id")
  driverName     String?
  startTime      DateTime @map("start_time")
  endTime        DateTime? @map("end_time")
  distance       Float?
  duration       Int?
  maxSpeed       Float?   @map("max_speed")
  avgSpeed       Float?   @map("avg_speed")
  idleTime       Int?     @map("idle_time")
  overspeedCount Int?     @map("overspeed_count")
  harshBrakes    Int?     @map("harsh_brakes")
  harshAccel     Int?     @map("harsh_accel")
  status         String   @default("in_progress")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  @@index([vehicleId])
  @@index([organizationId])
  @@index([startTime])
  @@index([status])
}

// ----------------------
// FLEETOS — GEOFENCES
// ----------------------

model Geofence {
  id             String   @id @default(cuid())
  name           String
  type           String   @default("circle")
  centerLat      Float?   @map("center_lat")
  centerLng      Float?   @map("center_lng")
  radius         Float?
  polygonPoints  String?  @map("polygon_points")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

// ----------------------
// FLEETOS — ALERTS
// ----------------------

model AlertRule {
  id             String   @id @default(cuid())
  name           String
  type           String
  conditions     String?
  channels       String?  @default("in_app")
  organizationId String   @map("organization_id")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([type])
}

model Alert {
  id             String   @id @default(cuid())
  type           String
  severity       String   @default("medium")
  vehicleId      String?  @map("vehicle_id")
  driverName     String?
  vehiclePlate   String?
  message        String
  metadata       String?
  status         String   @default("open")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  resolvedAt     DateTime? @map("resolved_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?    @relation("AlertVehicle", fields: [vehicleId], references: [id])
  @@index([organizationId])
  @@index([status])
  @@index([vehicleId])
  @@index([createdAt])
}

// ----------------------
// MAINTENANCE
// ----------------------

model MaintenanceRecord {
  id             String   @id @default(cuid())
  vehicleId      String   @map("vehicle_id")
  type           String
  description    String?
  triggerType    String?  @map("trigger_type")
  triggerValue   Float?
  scheduledDate  DateTime? @map("scheduled_date")
  completedDate  DateTime? @map("completed_date")
  cost           Float?
  status         String   @default("upcoming")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])
  @@index([vehicleId])
  @@index([organizationId])
  @@index([status])
}

// ----------------------
// BILLING & SUBSCRIPTIONS
// ----------------------

model Plan {
  id             String   @id @default(cuid())
  name           String
  description    String?
  priceMonthly   Float    @map("price_monthly")
  priceAnnual    Float?   @map("price_annual")
  vehicleLimit   Int      @default(0) @map("vehicle_limit")
  features       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subscriptions  Subscription[]
}

model Subscription {
  id             String   @id @default(cuid())
  organizationId String   @unique @map("organization_id")
  planId         String   @map("plan_id")
  status         String   @default("active")
  vehicleCount   Int      @default(0) @map("vehicle_count")
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id])
  plan           Plan       @relation(fields: [planId], references: [id])
  invoices       Invoice[]
}

model Invoice {
  id             String   @id @default(cuid())
  invoiceNumber  String   @unique @map("invoice_number")
  organizationId String   @map("organization_id")
  subscriptionId String?  @map("subscription_id")
  amount         Float
  tax            Float    @default(0)
  total          Float
  status         String   @default("pending")
  dueDate        DateTime @map("due_date")
  paidAt         DateTime? @map("paid_at")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization   Organization  @relation(fields: [organizationId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  @@index([organizationId])
  @@index([status])
  @@index([subscriptionId])
}

// ----------------------
// CRM — QUOTATIONS
// ----------------------

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique @map("quotation_number")
  leadId          String?         @map("lead_id")
  contactId       String?         @map("contact_id")
  organizationId  String          @map("organization_id")
  subtotal        Float
  taxRate         Float           @default(5) @map("tax_rate")
  tax             Float           @default(0)
  total           Float
  status          String          @default("draft")
  validUntil      DateTime?       @map("valid_until")
  notes           String?
  terms           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  items          QuotationItem[]
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?         @relation(fields: [contactId], references: [id])
  lead           Lead?            @relation(fields: [leadId], references: [id])

  @@index([organizationId])
  @@index([leadId])
  @@index([status])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String    @map("quotation_id")
  sortOrder   Int       @default(0) @map("sort_order")
  description String
  quantity    Int
  unitPrice   Float    @map("unit_price")

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

// ----------------------
// SUPPORT / TICKETING
// ----------------------

model Ticket {
  id             String   @id @default(cuid())
  ticketNumber   String   @unique @map("ticket_number")
  organizationId String   @map("organization_id")
  subject        String
  description    String?
  priority       String   @default("medium")
  status         String   @default("open")
  vehiclePlate   String?
  assignedToId   String?  @map("assigned_to_id")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo     User? @relation("TicketAssigned", fields: [assignedToId], references: [id])
  @@index([organizationId])
  @@index([status])
  @@index([assignedToId])
}

// ----------------------
// CONTRACTS
// ----------------------

model Contract {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  title          String
  startDate      DateTime @map("start_date")
  endDate        DateTime? @map("end_date")
  status         String   @default("active")
  terms          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([status])
}

// ----------------------
// DOCUMENTS
// ----------------------

model Document {
  id             String   @id @default(cuid())
  name           String
  type           String
  fileUrl        String   @map("file_url")
  mimeType       String?  @map("mime_type")
  size           Int?
  organizationId String   @map("organization_id")
  uploadedBy     String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedByUser User?      @relation("DocumentUploader", fields: [uploadedBy], references: [id])
  @@index([organizationId])
  @@index([type])
}

// ----------------------
// NOTIFICATIONS
// ----------------------

model Notification {
  id             String   @id @default(cuid())
  userId         String?  @map("user_id")
  organizationId String?  @map("organization_id")
  type           String
  title          String
  body           String?
  read           Boolean  @default(false)
  metadata       String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User? @relation("NotificationUser", fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  @@index([userId])
  @@index([organizationId])
}

// ----------------------
// PLATFORM SETTINGS
// ----------------------

model Session {
  id             String   @id @default(cuid())
  token          String   @unique
  userId         String   @map("user_id")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

// ----------------------
// API KEYS (Phase 9)
// ----------------------

model ApiKey {
  id             String   @id @default(cuid())
  name           String
  key            String   @unique
  keyPrefix      String   @map("key_prefix")
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  permissions    String   @default("read")
  expiresAt      DateTime? @map("expires_at")
  lastUsedAt     DateTime? @map("last_used_at")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([organizationId])
  @@index([userId])
}

// ----------------------
// AI CONVERSATIONS
// ----------------------

model AIConversation {
  id             String   @id @default(cuid())
  userId         String?  @map("user_id")
  organizationId String?  @map("organization_id")
  type           String   @default("fleet_assistant")
  messages       String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User? @relation("AIConversationUser", fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
}
